<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_menu"
                android:background="?attr/colorPrimaryContainer"/>

            <!-- Search Bar -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="?attr/colorPrimaryContainer">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:tint="?attr/colorOnSurfaceVariant"/>

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Tìm kiếm file..."
                    android:paddingHorizontal="12dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"/>

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:visibility="visible"/>

                <ImageButton
                    android:id="@+id/btnMenuToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_menu"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>

            <!-- Search scope chips — chỉ hiện khi đang tìm kiếm -->
            <HorizontalScrollView
                android:id="@+id/searchScopeBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="?attr/colorPrimaryContainer"
                android:visibility="gone">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSearchScope"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSearchCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thư mục hiện tại"
                        android:checked="true"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSearchInternal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Bộ nhớ trong"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSearchSD"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💾 Thẻ MicroSD"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:visibility="gone"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSearchAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍 Tất cả"
                        style="@style/Widget.Material3.Chip.Filter"/>

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- File type filter chips — chỉ hiện khi đang tìm kiếm -->
            <HorizontalScrollView
                android:id="@+id/searchTypeBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:background="?attr/colorPrimaryContainer"
                android:visibility="gone">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSearchType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="false"
                    app:selectionRequired="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả loại"
                        android:checked="true"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼 Ảnh"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬 Video"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵 Âm thanh"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeDoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄 Tài liệu"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeArchive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗜 Nén"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeApk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 APK"
                        style="@style/Widget.Material3.Chip.Filter"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📁 Thư mục"
                        style="@style/Widget.Material3.Chip.Filter"/>

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Path breadcrumb -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:scrollbars="none"
                android:background="@color/surface_variant">
                <TextView
                    android:id="@+id/tvCurrentPath"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:singleLine="true"/>
            </HorizontalScrollView>
        </com.google.android.material.appbar.AppBarLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="@style/Widget.Material3.LinearProgressIndicator"
            app:layout_anchor="@id/appBar"
            app:layout_anchorGravity="bottom"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:clipToPadding="false"
            android:paddingBottom="80dp"/>

        <!-- Empty view -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_folder"
                android:alpha="0.3"/>
            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thư mục trống"
                android:textSize="16sp"
                android:alpha="0.5"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- FAB new folder -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNewFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="80dp"
            android:src="@drawable/ic_create_folder"
            android:contentDescription="Tạo thư mục mới"
            app:tint="@android:color/white"/>

        <!-- Bottom action bar for selection mode -->
        <LinearLayout
            android:id="@+id/bottomActionBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="?attr/colorPrimaryContainer"
            android:elevation="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCancelSelection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="?attr/colorOnPrimaryContainer"/>

            <ImageButton
                android:id="@+id/btnSelectAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_select_all"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="?attr/colorOnPrimaryContainer"/>

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="?attr/colorOnPrimaryContainer"/>

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/error"/>
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="8dp">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="?attr/colorPrimaryContainer"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="20dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_storage"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File Manager"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnPrimaryContainer"/>
        </LinearLayout>

        <!-- Timeline button -->
        <LinearLayout
            android:id="@+id/btnTimeline"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_timeline"
                android:tint="?attr/colorPrimary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timeline Ảnh/Video"
                android:textSize="15sp"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <!-- Trash button -->
        <LinearLayout
            android:id="@+id/btnTrash"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                android:tint="?attr/colorError"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thùng rác"
                android:textSize="15sp"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <!-- Cleanup button -->
        <LinearLayout
            android:id="@+id/btnCleanup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cleanup"
                android:tint="#FF6D00"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dọn dẹp"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File lớn, rỗng, rác"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" android:layout_marginVertical="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRUY CẬP NHANH"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingHorizontal="20dp"
            android:paddingBottom="4dp"
            android:letterSpacing="0.1"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sidebarRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Storage Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:background="?attr/colorSurfaceVariant">

            <TextView
                android:id="@+id/tvStorageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bộ nhớ trong"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <ProgressBar
                android:id="@+id/storageProgress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                style="@style/Widget.Material3.LinearProgressIndicator"
                android:layout_marginVertical="6dp"
                android:progress="60"/>

            <TextView
                android:id="@+id/tvStorageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
