<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:paddingHorizontal="12dp"
    android:background="?attr/selectableItemBackground"
    android:stateListAnimator="@null">

    <!--
        Dùng 1 FrameLayout làm "slot" cố định 52dp bên trái.
        Cả ivThumbnail lẫn ivIcon đều nằm trong slot này.
        → text/infoRow luôn constraint vào slot, không bao giờ bị đè.
    -->
    <FrameLayout
        android:id="@+id/iconSlot"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Thumbnail: ảnh / video -->
        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <!-- Icon: folder / doc / audio / ... -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="visible"/>

    </FrameLayout>

    <!-- Tên file — luôn bắt đầu sau iconSlot -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurface"
        android:maxLines="1"
        android:ellipsize="middle"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/iconSlot"
        app:layout_constraintEnd_toStartOf="@id/checkBox"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/infoRow"/>

    <!-- Size / date / ext -->
    <LinearLayout
        android:id="@+id/infoRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/iconSlot"
        app:layout_constraintEnd_toStartOf="@id/checkBox"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvExtension"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
