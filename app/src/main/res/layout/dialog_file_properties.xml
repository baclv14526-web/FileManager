<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="Tên:" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvName" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp" android:ellipsize="middle" android:maxLines="1"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="top" android:minHeight="40dp"
        android:paddingVertical="8dp">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="Đường dẫn:" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvPath" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp" android:textIsSelectable="true"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="Loại:" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvType" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="Kích thước:" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvSize" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="Ngày sửa:" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="Đọc được:" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvReadable" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="Ghi được:" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvWritable" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp"/>
    </LinearLayout>

</LinearLayout>
