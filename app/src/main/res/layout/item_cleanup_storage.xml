<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EEF0FF"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THÔNG TIN BỘ NHỚ"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textColor="#49454F"
        android:layout_marginBottom="10dp"/>

    <!-- Bộ nhớ trong -->
    <LinearLayout
        android:id="@+id/internalRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_storage" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/tvInternalName" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Bộ nhớ trong" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvInternalUsage" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#49454F"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pbInternal" android:layout_width="match_parent"
            android:layout_height="8dp" android:progress="0"
            style="@style/Widget.Material3.LinearProgressIndicator"/>
    </LinearLayout>

    <!-- SD card (ẩn nếu không có) -->
    <LinearLayout
        android:id="@+id/sdRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_storage" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/tvSDName" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Thẻ MicroSD" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvSDUsage" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#49454F"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pbSD" android:layout_width="match_parent"
            android:layout_height="8dp" android:progress="0"
            style="@style/Widget.Material3.LinearProgressIndicator"/>
    </LinearLayout>

    <!-- Scope chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:layout_marginTop="4dp">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupScan"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipScanAll"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tất cả" android:checked="true"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipScanInternal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📱 Bộ nhớ trong" style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipScanSD"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💾 Thẻ MicroSD" style="@style/Widget.Material3.Chip.Filter"
                android:visibility="gone"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Nút quét -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScan"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="🔍  Bắt đầu quét"
        android:layout_marginTop="10dp"
        style="@style/Widget.Material3.Button"/>
</LinearLayout>
